# Copy outside source control into the deployment's config/runtime.env (mode 600).
TUDA_PUBLIC_URL=https://tuda.example.com
TUDA_BIND_ADDRESS=127.0.0.1
TUDA_PORT=18473
DATABASE_URL=postgresql://tuda:REPLACE_WITH_RANDOM_PASSWORD@db:5432/tuda
TUDA_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TUDA_MASTER_KEY=REPLACE_WITH_AT_LEAST_40_RANDOM_CHARACTERS
TUDA_ORGANIZATION_NAME=企业空间
DINGTALK_CORP_ID=REPLACE_WITH_ALLOWED_ORGANIZATION_ID
DINGTALK_CLIENT_ID=TUDA_APPLICATION_CLIENT_ID
DINGTALK_CLIENT_SECRET=TUDA_APPLICATION_CLIENT_SECRET
DINGTALK_ADMIN_UNION_ID=REPLACE_WITH_INITIAL_ADMIN_UNION_ID
TUDA_DEFAULT_ROLE=editor
# Explicitly opt in only for an isolated intranet development deployment.
TUDA_ALLOW_HTTP_LOGIN=false
# Optional company model services. Set only after choosing provider and model.
TUDA_IMAGE_BASE_URL=
TUDA_IMAGE_API_KEY=
TUDA_IMAGE_MODEL=
TUDA_TEXT_BASE_URL=
TUDA_TEXT_API_KEY=
TUDA_TEXT_MODEL=
# Public company authorization; configure all three values to enable storage-only authentication.
# Keep real deployment values outside source control.
TUDA_COMPANY_ORIGIN=
TUDA_COMPANY_ORGANIZATION_ID=
TUDA_COMPANY_NAS_SERVICE_TOKEN=
