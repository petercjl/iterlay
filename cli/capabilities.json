{
  "schemaVersion": 1,
  "name": "@petercjl/tuda",
  "version": "0.1.2",
  "kind": "cli-skill",
  "skills": [
    "using-tuda"
  ],
  "platforms": {
    "darwin": "development",
    "win32": "customer"
  },
  "requiredRuntime": {
    "node": ">=22.12.0",
    "desktop": "Tuda for canvas operations"
  },
  "agentEligibility": "valid-name-with-generic-fallback",
  "hostDiscoveryAuthority": "host",
  "automaticUpdates": {
    "enabled": true,
    "install": false,
    "intervalHours": 24,
    "timeoutMs": 600,
    "optOut": "TUDA_NO_UPDATE_CHECK=1"
  },
  "installationLifecycle": {
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill"
    ],
    "install": "skill install --target <exact-directory>",
    "update": "update install --target <exact-directory>",
    "verification": "skill status --target <exact-directory> --json",
    "agentNeutral": true,
    "explicitDestination": true,
    "hostDiscoveryVerificationRequired": true,
    "physicalRuntimeIsolation": true,
    "bootstrapNotice": "INSTALL.md",
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installerIntegration": "INSTALL.md: explicit package-managed skill install and host discovery handoff",
    "installationMode": "copy",
    "sharedLinksAllowed": false,
    "isolatedRuntimeRequired": true
  },
  "commandContracts": {
    "version": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "capabilities": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "doctor": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "skill source": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--target": {
          "type": "string",
          "semantics": "exact Skill directory"
        },
        "--agent": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "none"
    },
    "skill status": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--target": {
          "type": "string",
          "semantics": "exact Skill directory"
        },
        "--agent": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "none"
    },
    "skill install": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--target": {
          "type": "string",
          "semantics": "exact Skill directory"
        },
        "--agent": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "local-write"
    },
    "skill update": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--target": {
          "type": "string",
          "semantics": "exact Skill directory"
        },
        "--agent": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "local-write"
    },
    "update check": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--channel": {
          "type": "string",
          "enum": [
            "latest",
            "next"
          ]
        }
      },
      "sideEffects": "none"
    },
    "update install": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--target": {
          "type": "string",
          "semantics": "exact Skill directory"
        },
        "--agent": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        },
        "--channel": {
          "type": "string",
          "enum": [
            "latest",
            "next"
          ]
        }
      },
      "sideEffects": "package-and-skill-update"
    },
    "desktop prepare": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--app-path": {
          "type": "string"
        },
        "--user-data-path": {
          "type": "string"
        },
        "--startup-timeout": {
          "type": "number",
          "unit": "seconds",
          "minimum": 1,
          "maximum": 180
        }
      },
      "sideEffects": "local-write",
      "effects": [
        "start-hidden-desktop-if-needed"
      ]
    }
  },
  "discoveryContract": {
    "schemaVersion": 1,
    "entryPoints": [
      {
        "argv": [
          "capabilities",
          "--json"
        ],
        "result": "manifest"
      }
    ],
    "commandsField": "commandContracts",
    "version": {
      "command": "version",
      "argv": [
        "version",
        "--json"
      ],
      "fields": {
        "package": {
          "field": "package",
          "type": "string"
        },
        "version": {
          "field": "version",
          "type": "string"
        }
      }
    },
    "skillCollection": {
      "namesField": "skills",
      "default": "using-tuda",
      "selector": {
        "option": "--name",
        "type": "string"
      },
      "enumeration": {
        "argv": [
          "skill",
          "source",
          "--json"
        ],
        "itemsField": "skills",
        "completeField": "complete"
      },
      "namedSource": [
        "skill",
        "source",
        "--name",
        "{skill}",
        "--json"
      ]
    }
  },
  "maintenanceContract": {
    "schemaVersion": 1,
    "agentEligibility": "valid-name-with-generic-fallback",
    "hostDiscoveryAuthority": "host",
    "targetOptions": {
      "--target": {
        "type": "string",
        "kind": "skill-directory"
      }
    },
    "source": {
      "name": {
        "field": "name",
        "type": "string"
      },
      "package": {
        "field": "package",
        "type": "string"
      },
      "version": {
        "field": "version",
        "type": "string"
      },
      "path": {
        "field": "sourcePath",
        "type": "string"
      }
    },
    "status": {
      "name": {
        "field": "name",
        "type": "string"
      },
      "package": {
        "field": "package",
        "type": "string"
      },
      "version": {
        "field": "version",
        "type": "string"
      },
      "target": {
        "field": "target",
        "type": "string"
      },
      "installed": {
        "field": "installed",
        "type": "boolean"
      },
      "managed": {
        "field": "managed",
        "type": "boolean"
      },
      "current": {
        "field": "current",
        "type": "boolean"
      },
      "edited": {
        "field": "edited",
        "type": "boolean"
      },
      "verification": {
        "field": "verification",
        "type": "object"
      },
      "recovery": {
        "field": "recovery",
        "type": "object"
      }
    }
  },
  "nativePlugin": {
    "contract": 1,
    "profile": "boards-only",
    "transport": "stdio-mcp",
    "entry": "dist/board-plugin.js",
    "requiresSkill": false,
    "requiresDesktop": true,
    "environment": {
      "TUDA_USER_DATA_PATH": "exact private workspace directory",
      "TUDA_APP_PATH": "compatible desktop root",
      "TUDA_PLUGIN_SPACE": "fixed personal or enterprise space",
      "TUDA_SPACE": "alias with precedence",
      "TUDA_EMBEDDED_HOST": "host identity for isolated packaged desktop",
      "TUDA_AUTH_HANDOFF_FILE": "host-private short-lived PKCE handoff file; never a model argument",
      "TUDA_STARTUP_TIMEOUT_MS": "background readiness deadline, 1000..180000 ms; native plugin default 120000"
    },
    "generationTools": false,
    "preparation": {
      "argv": [
        "desktop",
        "prepare",
        "--app-path",
        "{appRoot}",
        "--user-data-path",
        "{userData}",
        "--startup-timeout",
        "120",
        "--json"
      ],
      "readyField": "data.ready",
      "instanceField": "data.instanceId",
      "requiresAuth": false,
      "sequence": [
        "prepare",
        "issue-instance-bound-handoff",
        "tools/call"
      ],
      "contract": 1,
      "resultSchema": {
        "type": "object",
        "required": [
          "schemaVersion",
          "ok",
          "data"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "ok": {
            "const": true
          },
          "data": {
            "type": "object",
            "required": [
              "ready",
              "instanceId",
              "protocolVersion"
            ],
            "properties": {
              "ready": {
                "const": true
              },
              "instanceId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "protocolVersion": {
                "const": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "authHandoff": {
      "contract": 1,
      "transport": "private-file",
      "environment": "TUDA_AUTH_HANDOFF_FILE",
      "targetAppId": "tuda",
      "required": [
        "contract",
        "origin",
        "appId",
        "code",
        "verifier",
        "expiresAt",
        "instanceId"
      ],
      "instanceField": "instanceId",
      "bindingSource": "nativePlugin.preparation.data.instanceId",
      "sessionPersistence": "memory-only",
      "sequence": [
        "prepare-desktop",
        "issue-handoff",
        "write-instance-bound-file",
        "tools/call"
      ]
    },
    "desktopCompatibility": {
      "contract": 1,
      "protocolVersion": 1,
      "minimumVersion": "0.1.0"
    },
    "updates": {
      "contract": 1,
      "owner": "host",
      "package": "@petercjl/tuda",
      "channel": "latest",
      "mode": "automatic",
      "intervalHours": 24,
      "timeoutMs": 1500,
      "activation": "next-connection",
      "compatibility": "same-minor-for-0.x-same-major-for-1.x",
      "failure": "keep-active"
    },
    "sharedDesktopSession": {
      "contract": 1,
      "authScope": "connection",
      "preservesDesktopSession": true,
      "transport": "private-file-pkce-with-connection-secret",
      "sessionPersistence": "memory-only",
      "space": "enterprise",
      "source": "codex-own"
    }
  }
}
